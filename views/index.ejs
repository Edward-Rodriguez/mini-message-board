<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css"/>
    <title><%= title %></title>
  </head>
  <body>
    <h1>Messages</h1>
    <a href="/new" class="link">Add Message</a>
    <% if (messages.length > 0) { %> 
        <ul class="message-list">
            <% for (let i = messages.length - 1; i >= 0; i--) { %>
                <li class="message">
                    <h2 class="user"><%= messages[i].user %></h2>
                    <h4 class="date"><%= formatDate(messages[i].added) %></h4>
                    <p class="text-message"><%= messages[i].text %></p>
                </li>
            <% }; %>
        </ul>
    <% } %>
  </body>
</html>
